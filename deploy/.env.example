# Public host. For the temporary domain, use a real HTTPS-capable hostname.
APP_HOST=204-168-215-163.sslip.io
EPUSDT_HOST=pay.204-168-215-163.sslip.io

# New API
# Custom Stage 1 image built from ../new-api-src by deploy/docker-compose.yml.
# To deploy an upstream pinned image without local source modifications, remove or override the new-api build block too.
NEW_API_IMAGE=new-api-stage1-custom:wallet-nowpayments
NEW_API_SESSION_SECRET=replace-with-64-char-random-string
NEW_API_CRYPTO_SECRET=replace-with-32-char-random-string
NEW_API_ADMIN_ACCESS_TOKEN=replace-with-new-api-admin-access-token
NEW_API_ADMIN_USER_ID=1
NEW_API_QUOTA_PER_USD=500000

# MySQL
MYSQL_DATABASE=new_api
MYSQL_USER=newapi
MYSQL_PASSWORD=replace-with-random-mysql-password
MYSQL_ROOT_PASSWORD=replace-with-random-root-password

# Redis
REDIS_PASSWORD=replace-with-random-redis-password

# Payment bridge
PAYMENT_BRIDGE_SESSION_SECRET=replace-with-64-char-random-string
PAYMENT_PROVIDER=epusdt
EPUSDT_API_BASE=https://pay.204-168-215-163.sslip.io
EPUSDT_PID=replace-with-epusdt-api-key-pid
EPUSDT_SECRET_KEY=replace-with-epusdt-secret-key
PAYMENT_PUBLIC_BASE_URL=https://204-168-215-163.sslip.io

# Recharge policy
RECHARGE_ALLOWED_AMOUNTS=1,5,15,30,50,100
RECHARGE_CURRENCY=USDTTRC20
RECHARGE_SUPPORTED_CURRENCIES=USDTTRC20,USDTBSC
RECHARGE_CREDIT_MULTIPLIER=1

# Operations
TZ=UTC
